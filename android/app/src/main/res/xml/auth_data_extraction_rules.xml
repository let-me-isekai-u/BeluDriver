<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup>
    <!-- Keystore keys cannot be restored with encrypted preferences. Also
         exclude legacy preferences while an upgrade migration may be pending. -->
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
  </cloud-backup>
  <device-transfer>
    <!-- Keystore keys cannot be restored with encrypted preferences. Also
         exclude legacy preferences while an upgrade migration may be pending. -->
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
  </device-transfer>
</data-extraction-rules>
